{
  "name": "night-shift",
  "version": "0.1.0",
  "description": "A Kiro Crew app: four agents patrol sites overnight with THE UNSEEN and report accessibility fixes in the morning.",
  "license": "MIT",
  "type": "module",
  "bin": { "night-shift": "dist/cli.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "test:integration": "vitest --run --config vitest.int.config.ts",
    "build:ui": "vite build --config ui/vite.config.ts",
    "demo:reject": "node scripts/demo-reject.mjs",
    "demo:regress": "node scripts/demo-regress.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:rebaseline": "node scripts/demo-rebaseline.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "fast-check": "^3.21.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.4"
  }
}
